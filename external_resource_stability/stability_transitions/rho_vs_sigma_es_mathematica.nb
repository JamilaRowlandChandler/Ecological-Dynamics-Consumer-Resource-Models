        "\t    ", "output"}], "}"}], ",", "\n", "\t    ", "\n", "\t    ", 
      RowBox[{
       RowBox[{
        RowBox[{"SolveODE", "[", 
         RowBox[{
         "initResourceA_", ",", " ", "initResourceB_", ",", " ", 
          "initConsumer_"}], "]"}], " ", ":=", " ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"sol", ",", " ", "status"}], "}"}], ",", "\n", "\t    ", 
          "\n", "\t    ", 
          RowBox[{
           RowBox[{"sol", " ", "=", " ", 
            RowBox[{"Quiet", "[", 
             RowBox[{"TimeConstrained", "[", 
              RowBox[{
               RowBox[{"NDSolve", "[", 
                RowBox[{
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"dRNdt", "[", "t", "]"}], ",", "\n", 
                   "\t\t\t\t\t\t\t\t\t\t\t\t\t ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"abioticResource", "[", "0", "]"}], " ", "==", 
                    " ", "initResourceA"}], ",", " ", 
                    RowBox[{
                    RowBox[{"bioticResource", "[", "0", "]"}], " ", "==", " ",
                     "initResourceB"}], ",", " ", 
                    RowBox[{
                    RowBox[{"Species", "[", "0", "]"}], " ", "==", " ", 
                    "initConsumer"}], ",", "\n", 
                    "\t\t\t\t\t\t\t\t\t\t\t\t\t ", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"abioticResource", "[", "t", "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"bioticResource", "[", "t", "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"Species", "[", "t", "]"}], "]"}]}], "]"}], " ", ">",
                     " ", 
                    SuperscriptBox["10", "6"]}], ",", 
                    " ", "\"\<StopIntegration\>\""}], "]"}]}], "}"}]}], "]"}],
                  ",", "\n", "\t\t\t\t\t\t\t\t\t\t\t   ", 
                 RowBox[{"{", 
                  RowBox[{
                  "abiotcResource", ",", " ", "bioticResource", ",", " ", 
                   "Species"}], "}"}], ",", "\n", "\t\t\t\t\t\t\t\t\t\t\t   ", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", " ", "0", ",", " ", "tEnd"}], "}"}], ",", 
                 "\n", "\t\t\t\t\t\t\t\t\t\t\t   ", 
                 RowBox[{"Method", " ", "\[Rule]", " ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<StiffnessSwitching\>\"", ",", " ", 
                    RowBox[{"\"\<Method\>\"", " ", "->", 
                    RowBox[{"{", 
                    
                    RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", " ", 
                    "Automatic"}], "}"}]}]}], "}"}]}], ",", "\n", 
                 "\t\t\t\t\t\t\t\t\t\t\t   ", 
                 RowBox[{"AccuracyGoal", " ", "->", " ", "9"}], ",", " ", 
                 RowBox[{"PrecisionGoal", " ", "->", " ", "7"}]}], "]"}], ",",
                "\n", "\t\t\t\t\t\t\t\t\t", "120", ",", " ", "$Failed"}], 
