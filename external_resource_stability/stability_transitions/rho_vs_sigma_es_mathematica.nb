 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"StabilitySimulation", "[", 
     RowBox[{
     "filename_", ",", " ", "model_", ",", " ", "parameterSets_Association", ",",
       " ", "simulation_Association", ",", " ", 
      RowBox[{"nRep_", ":", " ", "20"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\n", "\n", "    ", 
       RowBox[{
        RowBox[{"tEnd", " ", "=", " ", 
         RowBox[{"simulation", "[", "\"\<tEnd\>\"", "]"}]}], ",", "\n", 
        "    ", "\n", "    ", "FormatParams", ",", "\n", "    ", "\n", "    ",
         "varyingParams", ",", "\n", "    ", "fixedParams", ",", "\n", "    ",
         "paramNames", ",", "\n", "    ", "paramRanges", ",", "\n", "    ", 
        "allCombinations", ",", "\n", "    ", "maxLEs", ",", "\n", "    ", 
        "dataTemp", ",", "\n", "    ", "oldKeys", ",", "\n", "    ", 
        "newKeys", ",", "\n", "    ", "output"}], "}"}], ",", "\n", "    ", 
      "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"FormatParams", "[", "params_Association", "]"}], " ", ":=", 
        " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"KeyDrop", "[", 
           RowBox[{"params", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\[Mu]interact\>\"", ",", 
              " ", "\"\<\[Sigma]interact\>\""}], "}"}]}], "]"}], ",", " ", 
          "\n", "\t\t\t\t\t\t\t\t\t\t         ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<\[Mu]c\>\"", " ", "->", " ", 
             RowBox[{"params", "[", "\"\<\[Mu]interact\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<\[Sigma]c\>\"", " ", "->", " ", 
             RowBox[{"params", "[", "\"\<\[Sigma]interact\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<\[Mu]g\>\"", " ", "->", " ", 
             RowBox[{"params", "[", "\"\<\[Mu]interact\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<\[Sigma]g\>\"", " ", "->", " ", 
             RowBox[{"params", "[", "\"\<\[Sigma]interact\>\"", "]"}]}]}], 
           "|>"}]}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
       RowBox[{"varyingParams", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"parameterSets", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "0"}], " ", 
           "&"}]}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"fixedParams", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"parameterSets", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], " ", "===", " ", "0"}], " ", 
           "&"}]}], "]"}]}], ";", "\n", "    ", "\n", "    ", 
       RowBox[{"paramNames", " ", "=", " ", 
        RowBox[{"Keys", "[", "varyingParams", "]"}]}], ";", "\n", "    ", 
       RowBox[{"paramRanges", " ", "=", " ", 
        RowBox[{"Values", "[", "varyingParams", "]"}]}], ";", "\n", "    ", 
       RowBox[{"allCombinations", " ", "=", " ", 
        RowBox[{"Tuples", "[", "paramRanges", "]"}]}], ";", "\n", "    ", 
       "\n", "    ", 
       RowBox[{"LaunchKernels", "[", "]"}], ";", "\n", "\t", 
       RowBox[{"DistributeDefinitions", "[", 
        RowBox[{
        "StabilityParmSet", ",", " ", "AbioticCRM", ",", " ", "BioticCRM", ",",
          " ", "SimulateDynamics", ",", " ", "GenerateGrowthConsumption", ",",
          " ", "CommunityProperties", ",", "\n", "\t\t\t\t\t\t ", 
         "FormatParams"}], "]"}], ";", "\n", "    ", 
       RowBox[{"ParallelEvaluate", "[", 
        RowBox[{"Off", "[", 
         RowBox[{"Set", "::", "shape"}], "]"}], "]"}], ";", "\n", "    ", 
       "\n", "    ", 
       RowBox[{"maxLEs", " ", "=", " ", 
        RowBox[{
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "paramSet", "}"}], ",", "\n", "\t\t\t\t\t\t\t\t  ", 
             RowBox[{
              RowBox[{"paramSet", " ", "=", " ", 
               RowBox[{"FormatParams", "[", 
                RowBox[{"Join", "[", 
                 RowBox[{"fixedParams", ",", " ", 
                  RowBox[{"AssociationThread", "[", 
                   RowBox[{"paramNames", ",", " ", "parmcombo"}], "]"}]}], 
                 "]"}], "]"}]}], ";", "\n", "\t\t\t\t\t\t\t\t  ", 
              RowBox[{"StabilityParmSet", "[", 
               RowBox[{
               "model", ",", " ", "paramSet", ",", " ", "tEnd", ",", " ", 
                "nRep"}], "]"}]}]}], "]"}], ",", "\n", "\t\t\t\t\t\t   ", 
           RowBox[{"{", 
            RowBox[{"parmcombo", ",", " ", "allCombinations"}], "}"}]}], 
          "]"}], " ", "//", " ", "Quiet"}]}], ";", "\n", "\t\t\t\t\t\t   ", 
       "\n", "\t", 
       RowBox[{"ParallelEvaluate", "[", 
        RowBox[{"On", "[", 
         RowBox[{"Set", "::", "shape"}], "]"}], "]"}], ";", "\n", "\t", "\n", 
       "\t", 
       RowBox[{"dataTemp", " ", "=", " ", 
        RowBox[{"Dataset", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"maxLEs", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"oldKeys", " ", "=", " ", 
        RowBox[{"Keys", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "dataTemp", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"newKeys", " ", "=", " ", 
        RowBox[{"oldKeys", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<\[Rho]\>\"", " ", "->", " ", "\"\<rho\>\""}], ",", 
           " ", 
           RowBox[{"\"\<\[Mu]c\>\"", " ", "->", " ", "\"\<mu_c\>\""}], ",", 
           " ", 
           RowBox[{"\"\<\[Sigma]c\>\"", " ", "->", " ", "\"\<sigma_c\>\""}], ",",
            " ", "\n", "\t                      ", 
           RowBox[{"\"\<\[Mu]g\>\"", " ", "->", " ", "\"\<mu_g\>\""}], ",", 
           " ", 
           RowBox[{"\"\<\[Sigma]g\>\"", " ", "->", " ", "\"\<sigma_g\>\""}], ",",
            " ", 
           RowBox[{"\"\<\[Mu]d\>\"", " ", "->", " ", "\"\<mu_d\>\""}], ",", 
           " ", "\n", "\t                      ", 
           RowBox[{"\"\<\[Sigma]d\>\"", " ", "->", " ", "\"\<sigma_d\>\""}], ",",
            " ", 
           RowBox[{"\"\<\[Mu]b\>\"", " ", "->", " ", "\"\<mu_b\>\""}], ",", 
           " ", 
           RowBox[{"\"\<\[Sigma]b\>\"", " ", "->", " ", "\"\<sigma_b\>\""}], ",",
            "\n", "\t                      ", 
           RowBox[{"\"\<\[Mu]o\>\"", " ", "->", " ", "\"\<mu_o\>\""}], ",", 
           " ", 
           RowBox[{"\"\<\[Sigma]o\>\"", " ", "->", " ", "\"\<sigma_o\>\""}]}],
           "}"}]}]}], ";", "\n", "\t", 
       RowBox[{"output", " ", "=", " ", 
        RowBox[{"Dataset", "[", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AssociationThread", "[", 
             RowBox[{"newKeys", ",", " ", 
              RowBox[{"Values", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", 
           " ", 
           RowBox[{"Normal", "[", "dataTemp", "]"}]}], "]"}], "]"}]}], ";", 
       "\n", "\t", "\n", "\t", 
       RowBox[{"Export", "[", 
        RowBox[{"filename", ",", " ", "output", ",", " ", "\"\<CSV\>\""}], 
        "]"}], ";"}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"StabilityParmSet", "[", 
    RowBox[{
    "model_", ",", " ", "paramSet_Association", ",", " ", "tEnd_", ",", " ", 
     "nRep_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", "\n", "\t\t", 
      RowBox[{"CRM", ",", "\n", "\t\t", "maxLeParmSet"}], "}"}], ",", "\n", 
     "\t\t", "\n", "\t\t", 
     RowBox[{
      RowBox[{"CRM", " ", "=", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "model", ",", " ", "\"\<Abiotic\>\"", ",", " ", "AbioticCRM", ",", 
         " ", "\"\<Biotic\>\"", ",", "  ", "BioticCRM"}], "]"}]}], ";", "\n", 
      "\t\t", "\n", "\t\t", 
      RowBox[{"maxLeParmSet", " ", "=", " ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"paramSet", ",", " ", 
            RowBox[{"KeyDrop", "[", 
             RowBox[{
              RowBox[{"CRM", "[", 
               RowBox[{"paramSet", ",", " ", 
                RowBox[{"<|", 
                 RowBox[{"\"\<tEnd\>\"", " ", "->", " ", "tEnd"}], "|>"}]}], 
               "]"}], ",", "\n", "\t\t\t\t\t                                ", 
              RowBox[{"{", 
               
               RowBox[{"\"\<ResourceDynamics\>\"", ",", 
                " ", "\"\<ConsumerDynamics\>\""}], "}"}]}], "]"}]}], "]"}], ",",
           "\n", "\t\t\t\t\t\t", 
          RowBox[{"{", 
           RowBox[{"n", ",", " ", "1", ",", " ", "nRep"}], "}"}]}], "]"}], 
        " ", "//", " ", "Quiet"}]}], ";", "\n", "\t\t\t                 ", 
      "\n", "\t\t", "maxLeParmSet"}]}], "\n", "\t\t\t\t\t\t\t\t\t\t\t", "\n", 
    "\t", "]"}]}], ";"}]}], "Code",
