Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GenerateGrowthConsumption", "[", 
     RowBox[{
     "M_", ",", " ", "S_", ",", " ", "\[Mu]g_", ",", " ", "\[Sigma]g_", ",", 
      " ", "\[Mu]c_", ",", " ", "\[Sigma]c_", ",", " ", "\[Rho]_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\n", "\t\t", 
       RowBox[{
       "xC", ",", "\n", "\t\t", "xG", ",", "\n", "\t\t", "growth", ",", "\n", 
        "\t\t", "consumption"}], "}"}], ",", "\n", "\t\t", "\n", "\t\t", 
      RowBox[{
       RowBox[{"xC", " ", "=", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"M", ",", " ", "S"}], "}"}]}], "]"}]}], ";", " ", "\n", 
       "\t\t", 
       RowBox[{"xG", " ", "=", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"S", ",", " ", "M"}], "}"}]}], "]"}]}], ";", " ", "\n", 
       "\t\t", "\n", "\t\t", 
       RowBox[{"growth", " ", "=", " ", 
        RowBox[{
         FractionBox["\[Mu]g", "M"], "+", 
         RowBox[{
          FractionBox["\[Sigma]g", 
           RowBox[{"\[Sqrt]", "M"}]], "*", "xG"}]}]}], ";", "\n", "\t\t", 
       RowBox[{"consumption", " ", "=", " ", 
        RowBox[{
         FractionBox["\[Mu]c", "M"], "+", 
         RowBox[{
          FractionBox["\[Sigma]c", 
           RowBox[{"\[Sqrt]", "M"}]], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Rho]", "*", 
             RowBox[{"Transpose", "[", "xG", "]"}]}], " ", "+", " ", 
            RowBox[{
             RowBox[{"\[Sqrt]", 
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", 
                SuperscriptBox["\[Rho]", "2"]}], ")"}]}], "*", "xC"}]}], 
           ")"}]}]}]}], ";", "\n", "\t\t", "\n", "\t\t", 
       RowBox[{"{", 
        RowBox[{"growth", ",", " ", "consumption"}], "}"}]}]}], "\n", "\t", 
     "]"}]}], ";"}], "\n", "\t"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SimulateDynamicsCRM", "[", 
     RowBox[{"dRNdt_", ",", " ", "M_", ",", " ", "S_", ",", " ", "tEnd_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\n", "\n", "\t\t", 
       RowBox[{
       "SolveODE", ",", "\n", "\t\t", "\n", "\t\t", "initR", ",", "\n", 
        "\t    ", "initN", ",", "\n", "\t    ", "initRPerturbed", ",", "\n", 
        "\t    ", "initNPerturbed", ",", "\n", "\t ", "\n", "\t    ", 
        "solution", ",", "\n", "\t    ", "solutionPerturbed", ",", "\n", 
        "\t    ", "tLast", ",", "\n", "\t    ", "tLastP", ",", "\n", "\t    ",
         "evaluatedSolution", ",", "\n", "\t    ", 
        "evaluatedSolutionPerturbed", ",", "\n", "\t    ", 
        "distanceTrajectory", ",", "\n", "\t    ", "maxLE", ",", "\n", 
        "\t    ", "output"}], "}"}], ",", "\n", "\t    ", "\n", "\t    ", 
      RowBox[{
       RowBox[{
        RowBox[{"SolveODE", "[", 
         RowBox[{"initResource_", ",", " ", "initConsumer_"}], "]"}], " ", ":=",
         " ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"sol", ",", " ", "status"}], "}"}], ",", "\n", "\t    ", 
          "\n", "\t    ", 
          RowBox[{
           RowBox[{"sol", " ", "=", " ", 
            RowBox[{"Quiet", "[", 
             RowBox[{"TimeConstrained", "[", 
              RowBox[{
               RowBox[{"NDSolve", "[", 
                RowBox[{
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"dRNdt", "[", "t", "]"}], ",", "\n", 
                   "\t\t\t\t\t\t\t\t\t\t\t\t\t ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Resource", "[", "0", "]"}], " ", "==", " ", 
                    "initResource"}], ",", " ", 
                    RowBox[{
                    RowBox[{"Species", "[", "0", "]"}], " ", "==", " ", 
                    "initConsumer"}], ",", "\n", 
                    "\t\t\t\t\t\t\t\t\t\t\t\t\t ", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"Resource", "[", "t", "]"}], "]"}], ",", " ", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"Species", "[", "t", "]"}], "]"}]}], "]"}], " ", ">",
                     " ", 
                    SuperscriptBox["10", "6"]}], ",", 
                    " ", "\"\<StopIntegration\>\""}], "]"}]}], "}"}]}], "]"}],
                  ",", "\n", "\t\t\t\t\t\t\t\t\t\t\t   ", 
                 RowBox[{"{", 
                  RowBox[{"Resource", ",", " ", "Species"}], "}"}], ",", "\n",
                  "\t\t\t\t\t\t\t\t\t\t\t   ", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", " ", "0", ",", " ", "tEnd"}], "}"}], ",", 
                 "\n", "\t\t\t\t\t\t\t\t\t\t\t   ", 
                 RowBox[{"Method", " ", "\[Rule]", " ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<StiffnessSwitching\>\"", ",", " ", 
                    RowBox[{"\"\<Method\>\"", " ", "->", 
                    RowBox[{"{", 
                    
                    RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", " ", 
                    "Automatic"}], "}"}]}]}], "}"}]}], ",", "\n", 
                 "\t\t\t\t\t\t\t\t\t\t\t   ", 
                 RowBox[{"AccuracyGoal", " ", "->", " ", "9"}], ",", " ", 
                 RowBox[{"PrecisionGoal", " ", "->", " ", "7"}]}], "]"}], ",",
                "\n", "\t\t\t\t\t\t\t\t\t", "120", ",", " ", "$Failed"}], 
              "]"}], "]"}]}], ";", "\n", "\t    ", "\n", "\t    ", "sol"}]}], 
         "\n", "\t    ", "\n", "\t    ", "]"}]}], ";", "\n", "\t    ", "\n", 
       "\t    ", 
       RowBox[{"initR", " ", "=", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"UniformDistribution", "[", 
           RowBox[{"{", 
            RowBox[{
             SuperscriptBox["10", 
              RowBox[{"-", "8"}]], ",", " ", 
             FractionBox["2", "M"]}], "}"}], "]"}], ",", " ", "M"}], "]"}]}], 
       ";", "\n", "\t\t", 
       RowBox[{"initN", " ", "=", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"UniformDistribution", "[", 
           RowBox[{"{", 
            RowBox[{
             SuperscriptBox["10", 
              RowBox[{"-", "8"}]], ",", " ", 
             FractionBox["2", "S"]}], "}"}], "]"}], ",", " ", "S"}], "]"}]}], 
       ";", "\n", "\t\t\t\t\t\t   ", "\n", "\t\t", 
       RowBox[{"solution", " ", "=", " ", 
        RowBox[{"SolveODE", "[", 
         RowBox[{"initR", ",", " ", "initN"}], "]"}]}], ";", "\n", 
       "\t\t\t\t\t\t   ", "\n", "\t\t", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"solution", " ", "===", " ", "$Failed"}], ",", "\n", 
         "\t\t\t", 
         RowBox[{"(", 
          RowBox[{"output", " ", "=", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<ResourceDynamics\>\"", " ", "->", " ", "$Failed"}], 
             ",", " ", 
             RowBox[{"\"\<ConsumerDynamics\>\"", " ", "->", " ", "$Failed"}], 
             ",", " ", 
             RowBox[{"\"\<EndTime\>\"", " ", "->", " ", "$Failed"}], ",", " ", 
             RowBox[{"\"\<maxLe\>\"", " ", "->", " ", "$Failed"}]}], "|>"}]}],
           ")"}], ",", "\n", "\t\t\t", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"tLast", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"solution", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "]"}], "]"}], 
              "[", "\"\<Domain\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
           "\t\t\t", "\n", "\t\t\t", 
           RowBox[{"evaluatedSolution", " ", "=", " ", 
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<ResourceDynamics\>\"", " ", "->", " ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"Evaluate", "[", 
                   RowBox[{
                    RowBox[{"Resource", "[", "t", "]"}], "/.", 
                    RowBox[{"solution", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", " ", 
                    RowBox[{"Subdivide", "[", 
                    RowBox[{"0", ",", " ", "tLast", ",", " ", "200"}], 
                    "]"}]}], "}"}]}], "]"}]}], ",", "\n", 
               "\t\t\t\t\t\t\t      ", 
               RowBox[{"\"\<ConsumerDynamics\>\"", " ", "->", " ", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"Evaluate", "[", 
                   RowBox[{
                    RowBox[{"Species", "[", "t", "]"}], "/.", 
                    RowBox[{"solution", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", " ", 
                    RowBox[{"Subdivide", "[", 
                    RowBox[{"0", ",", " ", "tLast", ",", " ", "200"}], 
                    "]"}]}], "}"}]}], "]"}]}]}], "|>"}], " ", "//", " ", 
             "Quiet"}]}], ";", "\n", "\t\t\t\t\t\t\t ", "\n", "\t\t\t", 
           RowBox[{"initRPerturbed", " ", "=", " ", 
            RowBox[{"initR", " ", "+", " ", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}]}], ";", "\n", "\t\t\t", 
           RowBox[{"initNPerturbed", " ", "=", " ", 
            RowBox[{"initN", " ", "+", " ", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}]}], ";", "\n", "\t\t", "\n", "\t\t\t", 
           RowBox[{"solutionPerturbed", " ", "=", " ", 
            RowBox[{"SolveODE", "[", 
             RowBox[{"initRPerturbed", ",", " ", "initNPerturbed"}], "]"}]}], 
           ";", "\n", "\t\t\t", "\n", "\t\t\t", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"solutionPerturbed", " ", "===", " ", "$Failed"}], ",", 
             "\n", "\t\t\t\t", 
             RowBox[{"(", 
              RowBox[{"output", " ", "=", " ", 
               RowBox[{"Join", "[", 
                RowBox[{"evaluatedSolution", ",", " ", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<EndTime\>\"", " ", "->", " ", "tLast"}], ",", 
                   " ", 
                   RowBox[{"\"\<maxLe\>\"", " ", "->", " ", "$Failed"}]}], 
                  "|>"}]}], "]"}]}], ")"}], ",", "\n", "\t\t\t\t", 
             RowBox[{"(", "\n", "\t\t\t\t", 
              RowBox[{
               RowBox[{"evaluatedSolutionPerturbed", " ", "=", " ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Evaluate", "[", 
                    RowBox[{
                    RowBox[{"Resource", "[", "t", "]"}], "/.", 
                    RowBox[{"solutionPerturbed", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", " ", 
                    RowBox[{"Subdivide", "[", 
                    RowBox[{"0", ",", " ", "tLast", ",", " ", "200"}], 
                    "]"}]}], "}"}]}], "]"}], ",", "\n", 
                   "\t\t\t\t\t\t\t\t\t\t  ", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Evaluate", "[", 
                    RowBox[{
                    RowBox[{"Species", "[", "t", "]"}], "/.", 
                    RowBox[{"solutionPerturbed", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", " ", 
                    RowBox[{"Subdivide", "[", 
                    RowBox[{"0", ",", " ", "tLast", ",", " ", "200"}], 
                    "]"}]}], "}"}]}], "]"}]}], "}"}], " ", "//", " ", 
                 "Quiet"}]}], ";", "\n", "\t\t\t\t\t\t\t\t\t  ", "\n", 
               "\t\t\t\t", 
               RowBox[{"distanceTrajectory", " ", "=", " ", 
                RowBox[{"Log", "[", 
                 RowBox[{"10", ",", " ", 
                  RowBox[{"MapThread", "[", 
                   RowBox[{"EuclideanDistance", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{
                    "evaluatedSolution", "[", "\"\<ResourceDynamics\>\"", 
                    "]"}], ",", "\n", 
                    "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t    ", 
                    RowBox[{
                    "evaluatedSolution", "[", "\"\<ConsumerDynamics\>\"", 
                    "]"}], ",", " ", "2"}], "]"}], ",", "\n", 
                    "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"evaluatedSolutionPerturbed", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                    RowBox[{"evaluatedSolutionPerturbed", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", "2"}], "]"}]}], 
                    "}"}]}], "]"}]}], "]"}]}], ";", "\t\t\t\t\t", "\n", 
               "\t\t", "\n", "\t\t\t\t", 
               RowBox[{"maxLE", " ", "=", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"LinearModelFit", "[", 
                   RowBox[{
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Subdivide", "[", 
                    RowBox[{"0", ",", " ", "tLast", ",", " ", "200"}], "]"}], 
                    ",", " ", "distanceTrajectory"}], "}"}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "x"}], "}"}], ",", " ", "x"}], 
                   "]"}], "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", 
               "\t\t\t\t\t\t\t \t\t\t\t\t ", "\n", "\t\t\t\t", 
               RowBox[{"output", " ", "=", " ", 
                RowBox[{"Join", "[", 
                 RowBox[{"evaluatedSolution", ",", " ", 
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<EndTime\>\"", " ", "->", " ", "tLast"}], ",",
                     " ", 
                    RowBox[{"\"\<maxLe\>\"", " ", "->", " ", "maxLE"}]}], 
                   "|>"}]}], "]"}]}]}], ")"}]}], "]"}]}], "\n", "\t", "\n", 
          "\t\t", ")"}]}], "]"}], ";", "\n", "\t", "\n", "\t", "output"}]}], 
     "\n", "\t", "\n", "\t", "]"}]}], ";"}], "\n", "\t"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SimulateDynamicsAbioticBioticCRM", "[", 
     RowBox[{
     "dRNdt_", ",", " ", "M_", ",", " ", "S_", ",", " ", "gammaR_", ",", " ", 
      "tEnd_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\n", "\n", "\t\t", 
       RowBox[{
       "SolveODE", ",", "\n", "\t\t", "\n", "\t\t", "initRA", ",", "\n", 
        "\t\t", "initRB", ",", "\n", "\t    ", "initN", ",", "\n", "\t    ", 
        "initRAPerturbed", ",", "\n", "\t    ", "initRBPerturbed", ",", "\n", 
        "\t    ", "initNPerturbed", ",", "\n", "\t ", "\n", "\t    ", 
        "solution", ",", "\n", "\t    ", "solutionPerturbed", ",", "\n", 
