Cell[CellGroupData[{

Cell["Functions for running simulations across parameter space", "Section",
 CellChangeTimes->{{3.985080906746773*^9, 
  3.9850809171889553`*^9}},ExpressionUUID->"9156ace0-9e31-a945-8f90-\
8298874f332a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"StabilitySimulation", "[", 
     RowBox[{
     "filename_", ",", " ", "model_", ",", " ", "parameterSets_Association", ",",
       " ", "simulation_Association", ",", " ", 
      RowBox[{"nRep_", ":", " ", "20"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\n", "\n", "    ", 
       RowBox[{
        RowBox[{"tEnd", " ", "=", " ", 
         RowBox[{"simulation", "[", "\"\<tEnd\>\"", "]"}]}], ",", "\n", 
        "    ", "\n", "    ", "FormatParams", ",", "\n", "    ", "\n", "    ",
         "varyingParams", ",", "\n", "    ", "fixedParams", ",", "\n", "    ",
         "paramNames", ",", "\n", "    ", "paramRanges", ",", "\n", "    ", 
        "allCombinations", ",", "\n", "    ", "maxLEs", ",", "\n", "    ", 
        "dataTemp", ",", "\n", "    ", "oldKeys", ",", "\n", "    ", 
        "newKeys", ",", "\n", "    ", "output"}], "}"}], ",", "\n", "    ", 
      "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"FormatParams", "[", "params_Association", "]"}], " ", ":=", 
        " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"KeyDrop", "[", 
           RowBox[{"params", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\[Mu]interact\>\"", ",", 
              " ", "\"\<\[Sigma]interact\>\""}], "}"}]}], "]"}], ",", " ", 
          "\n", "\t\t\t\t\t\t\t\t\t\t         ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<\[Mu]c\>\"", " ", "->", " ", 
             RowBox[{"params", "[", "\"\<\[Mu]interact\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<\[Sigma]c\>\"", " ", "->", " ", 
             RowBox[{"params", "[", "\"\<\[Sigma]interact\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<\[Mu]g\>\"", " ", "->", " ", 
             RowBox[{"params", "[", "\"\<\[Mu]interact\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<\[Sigma]g\>\"", " ", "->", " ", 
             RowBox[{"params", "[", "\"\<\[Sigma]interact\>\"", "]"}]}]}], 
           "|>"}]}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
       RowBox[{"varyingParams", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"parameterSets", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "0"}], " ", 
           "&"}]}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"fixedParams", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"parameterSets", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], " ", "===", " ", "0"}], " ", 
           "&"}]}], "]"}]}], ";", "\n", "    ", "\n", "    ", 
       RowBox[{"paramNames", " ", "=", " ", 
        RowBox[{"Keys", "[", "varyingParams", "]"}]}], ";", "\n", "    ", 
       RowBox[{"paramRanges", " ", "=", " ", 
        RowBox[{"Values", "[", "varyingParams", "]"}]}], ";", "\n", "    ", 
       RowBox[{"allCombinations", " ", "=", " ", 
        RowBox[{"Tuples", "[", "paramRanges", "]"}]}], ";", "\n", "    ", 
       "\n", "    ", 
       RowBox[{"LaunchKernels", "[", "]"}], ";", "\n", "\t", 
       RowBox[{"DistributeDefinitions", "[", 
        RowBox[{
        "StabilityParmSet", ",", " ", "AbioticCRM", ",", " ", "BioticCRM", ",",
          " ", "HybridCRM", ",", " ", "AbioticandBioticCRM", ",", " ", 
         "AbioticELV", ",", " ", "BioticELV", ",", " ", "SimulateDynamicsCRM",
          ",", " ", "SimulateDynamicsELV", ",", " ", 
         "GenerateGrowthConsumption", ",", " ", "CommunityProperties", ",", 
         "\n", "\t\t\t\t\t\t ", "FormatParams"}], "]"}], ";", "\n", "    ", 
       RowBox[{"ParallelEvaluate", "[", 
        RowBox[{"Off", "[", 
         RowBox[{"Set", "::", "shape"}], "]"}], "]"}], ";", "\n", "    ", 
       "\n", "    ", 
       RowBox[{"maxLEs", " ", "=", " ", 
        RowBox[{
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "paramSet", "}"}], ",", "\n", "\t\t\t\t\t\t\t\t  ", 
             RowBox[{
              RowBox[{"paramSet", " ", "=", " ", 
               RowBox[{"FormatParams", "[", 
                RowBox[{"Join", "[", 
                 RowBox[{"fixedParams", ",", " ", 
                  RowBox[{"AssociationThread", "[", 
                   RowBox[{"paramNames", ",", " ", "parmcombo"}], "]"}]}], 
                 "]"}], "]"}]}], ";", "\n", "\t\t\t\t\t\t\t\t  ", 
              RowBox[{"StabilityParmSet", "[", 
               RowBox[{
               "model", ",", " ", "paramSet", ",", " ", "tEnd", ",", " ", 
                "nRep"}], "]"}]}]}], "]"}], ",", "\n", "\t\t\t\t\t\t   ", 
           RowBox[{"{", 
            RowBox[{"parmcombo", ",", " ", "allCombinations"}], "}"}]}], 
          "]"}], " ", "//", " ", "Quiet"}]}], ";", "\n", "\t\t\t\t\t\t   ", 
       "\n", "\t", 
       RowBox[{"ParallelEvaluate", "[", 
        RowBox[{"On", "[", 
         RowBox[{"Set", "::", "shape"}], "]"}], "]"}], ";", "\n", "\t", "\n", 
       "\t", 
       RowBox[{"dataTemp", " ", "=", " ", 
        RowBox[{"Dataset", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"maxLEs", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"oldKeys", " ", "=", " ", 
        RowBox[{"Keys", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "dataTemp", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"newKeys", " ", "=", " ", 
        RowBox[{"oldKeys", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<\[Rho]\>\"", " ", "->", " ", "\"\<rho\>\""}], ",", 
           " ", 
           RowBox[{"\"\<\[Mu]c\>\"", " ", "->", " ", "\"\<mu_c\>\""}], ",", 
           " ", 
           RowBox[{"\"\<\[Sigma]c\>\"", " ", "->", " ", "\"\<sigma_c\>\""}], ",",
            " ", "\n", "\t                      ", 
           RowBox[{"\"\<\[Mu]g\>\"", " ", "->", " ", "\"\<mu_g\>\""}], ",", 
           " ", 
           RowBox[{"\"\<\[Sigma]g\>\"", " ", "->", " ", "\"\<sigma_g\>\""}], ",",
            " ", 
           RowBox[{"\"\<\[Mu]d\>\"", " ", "->", " ", "\"\<mu_d\>\""}], ",", 
           " ", "\n", "\t                      ", 
           RowBox[{"\"\<\[Sigma]d\>\"", " ", "->", " ", "\"\<sigma_d\>\""}], ",",
            " ", 
           RowBox[{"\"\<\[Mu]b\>\"", " ", "->", " ", "\"\<mu_b\>\""}], ",", 
           " ", 
