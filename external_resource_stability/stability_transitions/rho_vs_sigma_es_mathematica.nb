Cell[CellGroupData[{

Cell["Numerically-stable simulations", "Subsection",
 CellChangeTimes->{{3.9850815977447357`*^9, 
  3.985081606827509*^9}},ExpressionUUID->"6393709d-e64b-6745-8ec9-\
3a1fdbfb57b4"],

Cell["\<\
Parameter space where simulations are numerically-stable (chaotic dynamics \
emerge in the unstable feasible region of the BioticCRM), but the \
self-consistency equations are poorly solved.
(The saving protocol for the biotic model is slightly different/more regular \
than the abiotic model because Mathematica often crashes in the chaotic \
region.)\
\>", "Text",
 CellChangeTimes->{{3.985080980949251*^9, 3.9850810894010353`*^9}, {
  3.9850814209127884`*^9, 
  3.9850814873655014`*^9}},ExpressionUUID->"b4be835e-753f-8643-abd5-\
aa2ff61489b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"StabilitySimulation", "[", 
       RowBox[{
        RowBox[{"\"\<C:/Users/jamil/Documents/PhD/Data/external_resource_\
stability/simulations/rho_vs_sigma_biotic/rho_\>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "\[Rho]val", "]"}], " ", "<>", 
         " ", "\"\<.csv\>\""}], ",", "\n", "\t\t\t\t\t\t", "\"\<BioticCRM\>\"",
         ",", "\n", "\t\t\t\t\t\t", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<M\>\"", " ", "->", " ", "150"}], ",", " ", 
          RowBox[{"\"\<S\>\"", " ", "->", " ", "150"}], ",", "\n", 
          "\t\t\t\t\t      ", 
          RowBox[{"\"\<\[Rho]\>\"", " ", "->", " ", "\[Rho]val"}], ",", " ", 
          RowBox[{"\"\<\[Mu]interact\>\"", " ", "->", " ", "50.0"}], ",", " ", 
          RowBox[{"\"\<\[Sigma]interact\>\"", " ", "->", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"2.0", ",", " ", "12.0", ",", " ", "0.5"}], "]"}]}], ",", 
          "\n", "\t\t\t\t\t      ", 
          RowBox[{"\"\<\[Mu]d\>\"", " ", "->", " ", "1.0"}], ",", " ", 
          RowBox[{"\"\<\[Sigma]d\>\"", " ", "->", " ", "0.1"}], ",", "\n", 
          "\t\t\t\t\t      ", 
          RowBox[{"\"\<\[Mu]b\>\"", " ", "->", " ", "1.0"}], ",", " ", 
          RowBox[{"\"\<\[Sigma]b\>\"", " ", "->", " ", "0.1"}]}], "|>"}], ",",
         "\n", "\t\t\t\t\t      ", 
        RowBox[{"<|", 
         RowBox[{"\"\<tEnd\>\"", " ", "->", " ", "400"}], "|>"}], ",", " ", 
        "30"}], "]"}], ",", " ", "\n", "\t\t\t\t\t      ", 
      RowBox[{"{", 
