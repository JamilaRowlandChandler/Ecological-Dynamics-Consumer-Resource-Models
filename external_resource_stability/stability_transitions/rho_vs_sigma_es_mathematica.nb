Cell["\<\
Setting suitable extinction thresholds (for calculating the consumer survival \
fraction)\
\>", "Subsection",
 CellChangeTimes->{{3.9850817432990074`*^9, 
  3.9850817632791977`*^9}},ExpressionUUID->"2c1c4c84-158c-b54e-b414-\
50aaef838b80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"N", "[", 
    FractionBox[
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"simulationTestA", "[", "\"\<ConsumerDynamics\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
       RowBox[{"x_", " ", "/;", " ", 
        RowBox[{"x", " ", ">", " ", 
         SuperscriptBox["10", 
          RowBox[{"-", "6.5"}]]}]}]}], "]"}], 
     RowBox[{"Length", "[", 
      RowBox[{
       RowBox[{"simulationTestA", "[", "\"\<ConsumerDynamics\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "]"}]], "]"}], ",", " ", "\"\< \>\"",
    ",", " ", 
   RowBox[{"simulationTestA", "[", 
    RowBox[{"[", "\"\<Nmean\>\"", "]"}], "]"}], ",", " ", "\"\< \>\"", ",", 
   " ", 
   RowBox[{"simulationTestA", "[", 
    RowBox[{"[", "\"\<Nfluct\>\"", "]"}], "]"}], ",", " ", "\"\< \>\"", ",", 
   " ", 
   RowBox[{"simulationTestA", "[", 
    RowBox[{"[", "\"\<Rmean\>\"", "]"}], "]"}], ",", " ", "\"\< \>\"", ",", 
   " ", 
