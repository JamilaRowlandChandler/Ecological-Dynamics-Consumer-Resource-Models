Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ExampleSimulationsCRM", "[", 
     RowBox[{
     "model_", ",", " ", "parameters_Association", ",", " ", "directory_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "CRM", ",", " ", "simulation", ",", " ", "rDynamics", ",", " ", 
        "cDynamics", ",", " ", "timeSteps", ",", " ", "df", ",", " ", 
        "colNames", ",", " ", "namedDf"}], "}"}], ",", "\n", "\n", "\t", 
      RowBox[{
       RowBox[{"CRM", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{
         "model", ",", " ", "\"\<Abiotic\>\"", ",", " ", "AbioticCRM", ",", 
          " ", "\"\<Biotic\>\"", ",", "  ", "BioticCRM"}], "]"}]}], ";", "\n",
        "\t", 
       RowBox[{"simulation", " ", "=", " ", 
        RowBox[{"CRM", "[", 
         RowBox[{"parameters", ",", " ", 
          RowBox[{"<|", 
           RowBox[{"\"\<tEnd\>\"", " ", "->", " ", "400"}], "|>"}]}], "]"}]}],
        ";", "\n", "\t", "\n", "\t", 
       RowBox[{"rDynamics", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"simulation", "[", "\"\<ResourceDynamics\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "alpha"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"alpha", ",", " ", "1", ",", " ", 
            RowBox[{"Length", "[", 
             RowBox[{
              RowBox[{"simulation", "[", "\"\<ResourceDynamics\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "All"}], "]"}], "]"}], "]"}]}], "}"}]}],
          "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"cDynamics", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"simulation", "[", "\"\<ConsumerDynamics\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "alpha"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"alpha", ",", " ", "1", ",", " ", 
            RowBox[{"Length", "[", 
             RowBox[{
              RowBox[{"simulation", "[", "\"\<ConsumerDynamics\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "All"}], "]"}], "]"}], "]"}]}], "}"}]}],
          "]"}]}], ";", "\n", "\t", "\n", "\t", 
       RowBox[{"timeSteps", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"simulation", "[", "\"\<EndTime\>\"", "]"}], ",", " ", 
          "200"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
       RowBox[{"df", " ", "=", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"rDynamics", ",", " ", "cDynamics", ",", " ", "1"}], "]"}],
           ",", " ", "timeSteps"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
       RowBox[{"colNames", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"\"\<resource\>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "i", "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "1", ",", " ", 
               RowBox[{
                RowBox[{"Dimensions", "[", "rDynamics", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
           "\t\t\t\t\t ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"\"\<consumer\>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "i", "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "1", ",", " ", 
               RowBox[{
                RowBox[{"Dimensions", "[", "cDynamics", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
           "\t\t\t\t\t ", 
           RowBox[{"{", "\"\<t\>\"", "}"}]}], "]"}], "]"}]}], ";", "\n", 
       "\t\t\t\t\t ", "\n", "\t", 
       RowBox[{"colNames", " ", "=", " ", 
        RowBox[{"ToString", " ", "/@", " ", "colNames"}]}], ";", 
       "\t\t\t\t \t ", "\n", "\t\t\t\t\t ", "\n", "\t", 
       RowBox[{"namedDf", " ", "=", " ", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "df", "]"}], ",", " ", "colNames"}], 
         "]"}]}], ";", "\n", "\t", 
       RowBox[{"Export", "[", 
        RowBox[{"directory", ",", " ", "namedDf", ",", " ", "\"\<CSV\>\""}], 
        "]"}], ";"}]}], "\n", "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ExampleSimulationsELV", "[", 
    RowBox[{
    "model_", ",", " ", "parameters_Association", ",", " ", "directory_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ELV", ",", " ", "simulation", ",", " ", "cDynamics", ",", " ", 
       "timeSteps", ",", " ", "df", ",", " ", "colNames", ",", " ", 
       "namedDf"}], "}"}], ",", "\n", "\n", "\t", 
     RowBox[{
      RowBox[{"ELV", " ", "=", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "model", ",", " ", "\"\<Abiotic\>\"", ",", " ", "AbioticELV", ",", 
         " ", "\"\<Biotic\>\"", ",", "  ", "BioticELV"}], "]"}]}], ";", "\n", 
      "\t", 
      RowBox[{"simulation", " ", "=", " ", 
       RowBox[{"CRM", "[", 
        RowBox[{"parameters", ",", " ", 
         RowBox[{"<|", 
          RowBox[{"\"\<tEnd\>\"", " ", "->", " ", "400"}], "|>"}]}], "]"}]}], 
      ";", "\n", "\t", "\[IndentingNewLine]", "\t", 
      RowBox[{"cDynamics", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"simulation", "[", "\"\<ConsumerDynamics\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "alpha"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"alpha", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{
             RowBox[{"simulation", "[", "\"\<ConsumerDynamics\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "All"}], "]"}], "]"}], "]"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"timeSteps", " ", "=", " ", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"simulation", "[", "\"\<EndTime\>\"", "]"}], ",", " ", 
         "200"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"df", " ", "=", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"cDynamics", ",", " ", "timeSteps"}], "]"}]}], ";", "\n", 
      "\t", "\n", "\t", 
      RowBox[{"colNames", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"\"\<consumer\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", 
              RowBox[{
               RowBox[{"Dimensions", "[", "cDynamics", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
          "\t\t\t\t\t      ", 
          RowBox[{"{", "\"\<t\>\"", "}"}]}], "]"}], "]"}]}], ";", "\n", 
      "\t\t\t\t\t ", "\n", "\t", 
      RowBox[{"colNames", " ", "=", " ", 
       RowBox[{"ToString", " ", "/@", " ", "colNames"}]}], ";", 
      "\t\t\t\t \t ", "\n", "\t\t\t\t\t ", "\n", "\t", 
      RowBox[{"namedDf", " ", "=", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "df", "]"}], ",", " ", "colNames"}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{"Export", "[", 
       RowBox[{"directory", ",", " ", "namedDf", ",", " ", "\"\<CSV\>\""}], 
       "]"}], ";"}]}], "\n", "\n", "]"}]}], ";"}]}], "Code",
