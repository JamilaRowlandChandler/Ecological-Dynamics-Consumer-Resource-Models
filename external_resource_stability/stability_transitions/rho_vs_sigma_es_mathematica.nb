Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]test", " ", "=", " ", "0.4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]test", " ", "=", " ", "50.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]test", " ", "=", " ", "5.0"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"paramTestA", " ", "=", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<M\>\"", " ", "->", " ", "150"}], ",", " ", 
      RowBox[{"\"\<S\>\"", " ", "->", " ", "150"}], ",", " ", 
      RowBox[{"\"\<\[Rho]\>\"", " ", "->", " ", "\[Rho]test"}], ",", " ", 
