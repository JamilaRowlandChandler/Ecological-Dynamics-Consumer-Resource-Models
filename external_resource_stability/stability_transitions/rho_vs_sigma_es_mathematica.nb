             SuperscriptBox["10", 
              RowBox[{"-", "8"}]], ",", " ", 
             FractionBox["2", 
              RowBox[{"M", "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", "gammaR"}], ")"}]}]]}], "}"}], "]"}], ",", 
