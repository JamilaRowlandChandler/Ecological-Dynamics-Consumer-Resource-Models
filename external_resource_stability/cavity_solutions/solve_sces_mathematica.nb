            "formattedParameters", ",", " ", "solverOptionsComplete"}], 
            "]"}]}]}], ",", "\n", "\t\t", "\n", "\t\t", 
         RowBox[{"output", " ", "=", " ", 
          RowBox[{"SCEsAbiotic", "[", 
           RowBox[{"formattedParameters", ",", " ", "solverOptions"}], 
           "]"}]}]}], "]"}], ";", "\n", "\t\t\t          ", "\n", "\t", 
       "output"}]}], "\n", "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"UpdateBadSolves", "[", 
    RowBox[{
    "oldFilename_", ",", " ", "newFilename_", ",", " ", 
     "solverOptions_Association", ",", " ", 
     RowBox[{"condition_", ":", " ", 
      RowBox[{"(", 
       RowBox[{"row", " ", "|->", " ", 
        RowBox[{"MemberQ", "[", 
         RowBox[{"row", ",", " ", "_Missing"}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"useBadSolve_", ":", " ", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\n", "\t\t\t\t \t", "\n", "\t", 
      RowBox[{
      "resultsDataset", ",", "\n", "\t", "DatatoModify", ",", "\n", "\t", 
       "failedIdx", ",", "\n", "\t", "rerunDataset", ",", "\n", "\t", 
       "columnNames", ",", "\n", "\t", "rerunDatasetConv", ",", "\n", "\t", 
       "resultsDatasetUpdated"}], "\n", "\t", "\n", "\t", "}"}], ",", " ", 
     "\n", "\n", "\t", 
     RowBox[{
      RowBox[{"resultsDataset", " ", "=", " ", 
       RowBox[{"Import", "[", 
        RowBox[{"oldFilename", ",", " ", "\"\<Tabular\>\""}], "]"}]}], ";", 
      "\n", "\t", "\n", "\t", 
      RowBox[{"DatatoModify", " ", "=", " ", 
       RowBox[{"Normal", "[", "resultsDataset", "]"}]}], ";", "\n", "\t", 
      RowBox[{"failedIdx", " ", "=", " ", 
       RowBox[{"Union", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"DatatoModify", ",", " ", 
           RowBox[{"row_", " ", "/;", " ", 
            RowBox[{"condition", "[", "row", "]"}]}]}], "]"}], "]"}], "]"}]}],
       ";", "\n", "\t\t", "\n", "\t", 
      RowBox[{"LaunchKernels", "[", "]"}], ";", "\n", "\t", 
      RowBox[{"DistributeDefinitions", "[", 
       RowBox[{"RerunSolve", ",", " ", "SCEsAbiotic"}], "]"}], ";", "\n", 
      "\t", "\n", "\t", 
      RowBox[{"rerunDataset", " ", "=", " ", 
       RowBox[{
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"RerunSolve", "[", 
           RowBox[{
           "DatatoModify", ",", " ", "failIdx", ",", " ", "solverOptions", ",",
             " ", "useBadSolve"}], "]"}], ",", "\n", "\t\t\t\t\t\t\t\t", 
          RowBox[{"{", 
           RowBox[{"failIdx", ",", " ", "failedIdx"}], "}"}]}], "]"}], " ", "//",
         " ", "Quiet"}]}], ";", "\n", "\t\t\t\t\t\t\t\t", "\n", "\t", 
      RowBox[{"columnNames", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<gamma\>\"", ",", " ", "\"\<rho\>\"", ",", 
         " ", "\"\<mu_c\>\"", ",", " ", "\"\<sigma_c\>\"", ",", 
         " ", "\"\<mu_g\>\"", ",", " ", "\"\<sigma_g\>\"", ",", 
         " ", "\"\<mu_d\>\"", ",", " ", "\"\<sigma_d\>\"", ",", 
         " ", "\"\<mu_b\>\"", ",", " ", "\"\<sigma_b\>\"", ",", 
         " ", "\"\<mu_o\>\"", ",", " ", "\"\<sigma_o\>\"", ",", "\n", 
         "\t  \t         ", "\"\<phi_N\>\"", ",", " ", "\"\<N_mean\>\"", ",", 
         " ", "\"\<q_N\>\"", ",", " ", "\"\<v_N\>\"", ",", 
         " ", "\"\<R_mean\>\"", ",", " ", "\"\<q_R\>\"", ",", 
         " ", "\"\<chi_R\>\"", ",", "\n", "\t  \t         ", "\"\<loss\>\"", ",",
          "\n", "\t  \t         ", "\"\<Packing ratio\>\"", ",", 
         " ", "\"\<Stability Term\>\"", ",", 
         " ", "\"\<Infeasibility Term\>\""}], "}"}]}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"rerunDatasetConv", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{"Tabular", "[", 
         RowBox[{"rerunDataset", ",", " ", "columnNames"}], "]"}], "]"}]}], ";",
       "\n", "\t", "\n", "\t", 
      RowBox[{"Do", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{"DatatoModify", " ", "=", " ", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{"DatatoModify", ",", " ", 
           RowBox[{
            RowBox[{"failedIdx", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", "->", " ", 
            RowBox[{"rerunDatasetConv", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], ",", "\n", 
        "\t\t\t\t\t\t\t\t\t", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Length", "[", "failedIdx", "]"}]}], "]"}]}], "}"}]}], 
       "\n", "\t", "]"}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"resultsDatasetUpdated", " ", "=", " ", 
       RowBox[{"Tabular", "[", 
        RowBox[{"DatatoModify", ",", " ", "columnNames"}], "]"}]}], ";", "\n",
       "\t", "\n", "\t", 
      RowBox[{"Export", "[", 
       RowBox[{
       "newFilename", ",", " ", "resultsDatasetUpdated", ",", 
        " ", "\"\<CSV\>\""}], "]"}], ";"}]}], "\n", "\t\t   ", "\n", "]"}]}], 
  ";"}], "\n"}], "Code",
