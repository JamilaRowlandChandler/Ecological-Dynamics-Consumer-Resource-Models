           "line"}]}], " ", "=", " ", 
         RowBox[{
          RowBox[{
          "We", " ", "use", " ", "the", " ", "RandomSearch", " ", "method", " ",
            "to", " ", "optimise", " ", "the", " ", 
           RowBox[{"sces", ".", " ", "This"}], " ", "line", " ", "tells", " ",
            "the", " ", "solver", " ", "\n", "\t\t\t\t\t", "the", " ", 
