Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RerunSolve", "[", 
     RowBox[{
     "Data_", ",", " ", "failIdx_", ",", " ", "solverOptions_Association", ",",
       " ", "useBadSolve_", ",", " ", 
      RowBox[{"model_", ":", " ", "\"\<Abiotic\>\""}]}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\n", "\n", "\t", 
       RowBox[{
       "extractedParameters", ",", "\n", "\t", "newKeys", ",", "\n", "\t", 
        "formattedParameters", ",", "\n", "\t", "CRM", ",", "\n", "\t", 
        "extractedInitVals", ",", "\n", "\t", "solverOptionsComplete", ",", 
        "\n", "\t", "output"}], "}"}], ",", " ", "\n", "\t", "\n", "\t", 
      RowBox[{
       RowBox[{"CRM", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{
         "model", ",", " ", "\"\<Abiotic\>\"", ",", " ", "SCEsAbiotic", ",", 
          " ", "\"\<Biotic\>\"", ",", " ", "SCEsBiotic"}], "]"}]}], ";", "\n",
        "\t", "\n", "\t", 
       RowBox[{"extractedParameters", " ", "=", " ", 
        RowBox[{"Data", "[", 
         RowBox[{"[", 
          RowBox[{"failIdx", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<gamma\>\"", ",", " ", "\"\<rho\>\"", ",", 
             " ", "\"\<mu_c\>\"", ",", " ", "\"\<sigma_c\>\"", ",", 
             " ", "\"\<mu_g\>\"", ",", " ", "\"\<sigma_g\>\"", ",", 
             " ", "\"\<mu_d\>\"", ",", " ", "\"\<sigma_d\>\"", ",", 
             " ", "\"\<mu_b\>\"", ",", " ", "\"\<sigma_b\>\"", ",", 
             " ", "\"\<mu_o\>\"", ",", " ", "\"\<sigma_o\>\""}], "}"}]}], 
          "]"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
       RowBox[{"newKeys", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<gamma\>\"", " ", "->", " ", "\"\<\[Gamma]\>\""}], ",", 
          " ", 
          RowBox[{"\"\<rho\>\"", " ", "->", " ", "\"\<\[Rho]\>\""}], ",", " ", 
          RowBox[{"\"\<mu_c\>\"", " ", "->", " ", "\"\<\[Mu]c\>\""}], ",", 
          " ", 
          RowBox[{"\"\<sigma_c\>\"", " ", "->", " ", "\"\<\[Sigma]c\>\""}], ",",
           " ", "\n", "\t           ", 
          RowBox[{"\"\<mu_g\>\"", " ", "->", " ", "\"\<\[Mu]g\>\""}], ",", 
          " ", 
          RowBox[{"\"\<sigma_g\>\"", " ", "->", " ", "\"\<\[Sigma]g\>\""}], ",",
           " ", 
          RowBox[{"\"\<mu_d\>\"", " ", "->", " ", "\"\<\[Mu]d\>\""}], ",", 
          " ", 
          RowBox[{"\"\<sigma_d\>\"", " ", "->", " ", "\"\<\[Sigma]d\>\""}], ",",
           "\n", "\t           ", 
          RowBox[{"\"\<mu_b\>\"", " ", "->", " ", "\"\<\[Mu]b\>\""}], ",", 
          " ", 
          RowBox[{"\"\<sigma_b\>\"", " ", "->", " ", "\"\<\[Sigma]b\>\""}], ",",
           "  ", 
          RowBox[{"\"\<mu_o\>\"", " ", "->", " ", "\"\<\[Mu]o\>\""}], ",", 
          " ", 
          RowBox[{"\"\<sigma_o\>\"", " ", "->", " ", "\"\<\[Sigma]o\>\""}]}], 
         "}"}]}], ";", "\n", "\t           ", "\n", "\t", 
       RowBox[{"formattedParameters", " ", "=", " ", 
        RowBox[{"KeyMap", "[", 
         RowBox[{
          RowBox[{"Replace", "[", "newKeys", "]"}], ",", " ", 
          "extractedParameters"}], "]"}]}], ";", "\n", "\t", "\n", "\t", "\n",
        "\t", "\n", "\t", 
       RowBox[{"If", "[", 
        RowBox[{"useBadSolve", ",", "\n", "\t", "\n", "\t\t", 
         RowBox[{
          RowBox[{"extractedInitVals", " ", "=", " ", 
           RowBox[{"Values", "[", 
            RowBox[{"Data", "[", 
             RowBox[{"[", 
              RowBox[{"failIdx", ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<phi_N\>\"", ",", " ", "\"\<N_mean\>\"", ",", 
                 " ", "\"\<q_N\>\"", ",", " ", "\"\<v_N\>\""}], "}"}]}], 
              "]"}], "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"solverOptionsComplete", " ", "=", " ", 
           RowBox[{"Join", "[", 
            RowBox[{"solverOptions", ",", " ", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<initialValues\>\"", " ", "->", " ", 
               "extractedInitVals"}], "|>"}]}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"output", " ", "=", " ", 
