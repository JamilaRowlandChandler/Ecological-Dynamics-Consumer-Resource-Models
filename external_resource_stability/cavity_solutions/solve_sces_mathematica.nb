Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TestFunc", "[", 
      RowBox[{"A_", ",", " ", "B_", ",", " ", "C_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", " ", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\n", "\n", "\t", 
       RowBox[{
        RowBox[{
         RowBox[{"WholeExpression", "[", 
          RowBox[{"D_", ",", " ", "x_", ",", " ", "y_"}], "]"}], " ", ":=", 
         " ", 
         RowBox[{"D", "*", 
          FractionBox["1", 
           RowBox[{"A", " ", "+", " ", 
            RowBox[{"B", "*", 
             SuperscriptBox["x", "2"]}], "+", 
            RowBox[{"C", "*", 
             SuperscriptBox["y", "2"]}]}]]}]}], ";", "\n", "\t", "\n", "\t", 
        RowBox[{"output1", " ", "=", " ", 
         RowBox[{"Assuming", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"A", " ", ">", " ", "0"}], ",", " ", 
             RowBox[{"B", " ", ">", " ", "0"}], ",", " ", 
             RowBox[{"C", " ", ">", " ", "0"}]}], "}"}], ",", "\n", 
           "\t\t\t\t\t ", 
           RowBox[{"Expectation", "[", 
            RowBox[{
             RowBox[{"WholeExpression", "[", 
              RowBox[{"2.0", ",", " ", "x", ",", " ", "y"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", " ", "\[Distributed]", " ", 
                RowBox[{"NormalDistribution", "[", "]"}]}], ",", " ", 
               RowBox[{"y", " ", "\[Distributed]", " ", 
                RowBox[{"NormalDistribution", "[", "]"}]}]}], "}"}]}], 
            "]"}]}], "]"}]}], ";", "\n", "\t\t\t\t\t ", "\n", "\t", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"output2", " ", "=", " ", 
           RowBox[{"Assuming", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"A", " ", ">", " ", "0"}], ",", " ", 
               RowBox[{"B", " ", ">", " ", "0"}], ",", " ", 
               RowBox[{"C", " ", ">", " ", "0"}]}], "}"}], ",", "\n", 
             "\t\t\t\t\t ", 
             RowBox[{"NExpectation", "[", 
              RowBox[{
               RowBox[{"WholeExpression", "[", 
                RowBox[{"x", ",", " ", "y"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x", " ", "\[Distributed]", " ", 
                  RowBox[{"NormalDistribution", "[", "]"}]}], ",", " ", 
                 RowBox[{"y", " ", "\[Distributed]", " ", 
                  RowBox[{"NormalDistribution", "[", "]"}]}]}], "}"}]}], 
              "]"}]}], "]"}]}], ";"}], "*)"}], "\n", "\t", "\n", "\t", 
        RowBox[{"N", "[", "output1", "]"}]}]}], "\n", "\t", 
      RowBox[{"(*", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"N", "[", "output1", "]"}], ",", " ", "output2"}], "}"}], 
       "*)"}], "\n", "]"}]}], ";"}], " ", "\n", "\n", 
   RowBox[{"TestFunc", "[", 
    RowBox[{"1.0", ",", " ", "2.0", ",", " ", "1.0"}], "]"}]}]}]], "Code",
 CellChangeTimes->{{3.981526257615242*^9, 
  3.981526272467785*^9}},ExpressionUUID->"80f30838-f81e-0c49-8426-\
c3c55cd17294"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SCEsIntegrate", "[", 
    RowBox[{
    "\[Gamma]_", ",", "\n", "\t\t\t  ", "\[Rho]_", ",", " ", "\[Mu]c_", ",", 
     " ", "\[Sigma]c_", ",", " ", "\[Mu]g_", ",", " ", "\[Sigma]g_", ",", 
     "\n", "\t\t\t  ", "\[Mu]d_", ",", " ", "\[Sigma]d_", ",", "\n", 
     "\t\t\t  ", "\[Mu]b_", ",", " ", "\[Sigma]b_", ",", " ", "\[Mu]o_", ",", 
     " ", "\[Sigma]o_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\n", "\t ", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Average", " ", "and", " ", "standard", " ", "deivation", " ", "in", " ",
        "net", " ", "species", " ", "growth", " ", "rate"}], " ", "*)"}], 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Mu]gN", "[", 
        RowBox[{
        "\[Phi]N_", ",", " ", "Nmean_", ",", " ", "Nfluct_", ",", " ", 
         "\[Nu]N_"}], "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"\[Mu]g", " ", "*", " ", 
         RowBox[{"Rmean", "[", 
          RowBox[{
          "\[Phi]N", ",", " ", "Nmean", ",", " ", "Nfluct", ",", " ", 
           "\[Nu]N"}], "]"}]}], " ", "-", " ", "\[Mu]d"}]}], ";", "\n", "\t", 
      RowBox[{
       RowBox[{"\[Sigma]gN", "[", 
        RowBox[{
        "\[Phi]N_", ",", " ", "Nmean_", ",", " ", "Nfluct_", ",", " ", 
         "\[Nu]N_"}], "]"}], " ", ":=", " ", 
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[Sigma]g", "2"], " ", "*", " ", 
            RowBox[{"Rfluct", "[", 
             RowBox[{
             "\[Phi]N", ",", " ", "Nmean", ",", " ", "Nfluct", ",", " ", 
              "\[Nu]N"}], "]"}]}], ")"}], "+", 
          SuperscriptBox["\[Sigma]d", "2"]}], ")"}]}]}], ";", "\n", "\t", 
      RowBox[{
       RowBox[{"\[Delta]gN", "[", 
        RowBox[{
        "\[Phi]N_", ",", " ", "Nmean_", ",", " ", "Nfluct_", ",", " ", 
         "\[Nu]N_"}], "]"}], " ", ":=", " ", 
       FractionBox[
        RowBox[{
         RowBox[{"\[Mu]gN", "[", 
          RowBox[{
          "\[Phi]N", ",", " ", "Nmean", ",", " ", "Nfluct", ",", " ", 
           "\[Nu]N"}], "]"}], " "}], 
        RowBox[{"\[Sigma]gN", "[", 
         RowBox[{
         "\[Phi]N", ",", " ", "Nmean", ",", " ", "Nfluct", ",", " ", 
          "\[Nu]N"}], "]"}]]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"Self", "-", "feedback"}], " ", "*)"}], "\n", "\t", 
      RowBox[{
       RowBox[{"FeedbackN", "[", 
        RowBox[{
        "\[Phi]N_", ",", " ", "Nmean_", ",", " ", "Nfluct_", ",", " ", 
         "\[Nu]N_"}], "]"}], " ", ":=", " ", 
       RowBox[{
       "\[Sigma]g", " ", "*", " ", "\[Sigma]c", " ", "*", " ", "\[Rho]", " ", 
        "*", " ", 
        RowBox[{"\[Chi]R", "[", 
         RowBox[{
         "\[Phi]N", ",", " ", "Nmean", ",", " ", "Nfluct", ",", " ", 
          "\[Nu]N"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Average", " ", "and", " ", "standard", " ", "devation", " ", "in", " ",
         "net", " ", "resource", " ", "growth", " ", "rate"}], " ", "*)"}], 
      "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"I", " ", "need", " ", "to", " ", "prevent", " ", 
         RowBox[{"recursion", ".", " ", "To"}], " ", "do", " ", "that"}], ",",
         " ", 
        RowBox[{"I", " ", 
         RowBox[{"won", "'"}], "t", " ", "define", " ", "my", " ", "net", " ",
          "resource", " ", "growth", " ", "rates", " ", "in", " ", "terms", " ",
          "of", " ", "other", " ", "functions"}]}], " ", "*)"}], "\n", "\t", 
      RowBox[{
       RowBox[{"\[Mu]gR", "[", 
        RowBox[{
        "\[Phi]N_", ",", " ", "Nmean_", ",", " ", "Nfluct_", ",", " ", 
         "\[Nu]N_"}], "]"}], " ", ":=", " ", 
       RowBox[{"\[Mu]o", " ", "+", " ", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"\[Mu]c", " ", "*", " ", "Nmean"}], ")"}], "\[Gamma]"]}]}], 
      ";", "\n", "\t", 
      RowBox[{
       RowBox[{"\[Sigma]gR", "[", 
        RowBox[{
        "\[Phi]N_", ",", " ", "Nmean_", ",", " ", "Nfluct_", ",", " ", 
         "\[Nu]N_"}], "]"}], " ", ":=", " ", 
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
