           ",", " ", "\"\<q_N\>\"", ",", " ", "\"\<v_N\>\"", ",", 
           " ", "\"\<R_mean\>\"", ",", " ", "\"\<q_R\>\"", ",", 
           " ", "\"\<chi_R\>\"", ",", "\n", 
           "\t\t\t\t\t\t\t\t\t", "\"\<loss\>\"", ",", "\n", 
           "\t\t\t\t\t\t\t\t\t", "\"\<Packing ratio\>\"", ",", 
           " ", "\"\<Stability Term\>\"", ",", 
           " ", "\"\<Infeasibility Term\>\""}], "}"}], ",", "\n", 
         "\t\t\t\t\t\t", "\"\<Biotic\>\"", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<gamma\>\"", ",", " ", "\"\<rho\>\"", ",", 
           " ", "\"\<mu_c\>\"", ",", " ", "\"\<sigma_c\>\"", ",", 
           " ", "\"\<mu_g\>\"", ",", " ", "\"\<sigma_g\>\"", ",", 
           " ", "\"\<mu_d\>\"", ",", " ", "\"\<sigma_d\>\"", ",", 
           " ", "\"\<mu_b\>\"", ",", " ", "\"\<sigma_b\>\"", ",", 
           " ", "\"\<mu_o\>\"", ",", " ", "\"\<sigma_o\>\"", ",", "\n", 
           "\t\t\t\t\t\t\t\t\t", "\"\<phi_N\>\"", ",", " ", "\"\<N_mean\>\"", 
           ",", " ", "\"\<q_N\>\"", ",", " ", "\"\<v_N\>\"", ",", 
           " ", "\"\<R_mean\>\"", ",", " ", "\"\<q_R\>\"", ",", 
           " ", "\"\<chi_R\>\"", ",", "\n", 
           "\t\t\t\t\t\t\t\t\t", "\"\<loss\>\"", ",", "\n", 
           "\t\t\t\t\t\t\t\t\t", "\"\<Packing ratio\>\"", ",", 
           " ", "\"\<Stability Threshold\>\"", ",", 
           " ", "\"\<Infeasibility Threshold\>\""}], "}"}]}], "]"}]}], ";", 
      "\n", "\n", "\t", 
      RowBox[{"resultsDataset", " ", "=", " ", 
       RowBox[{"Tabular", "[", 
        RowBox[{"solvedEquations", ",", " ", "columnNames"}], "]"}]}], ";", 
      "\n", "\n", "\t", 
      RowBox[{"Export", "[", 
       RowBox[{
       "filename", ",", " ", "resultsDataset", ",", " ", "\"\<CSV\>\""}], 
       "]"}], ";"}]}], "\n", "\n", "]"}]}], ";"}]], "Code",
