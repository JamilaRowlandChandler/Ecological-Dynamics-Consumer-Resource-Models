Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveSCEs", "[", 
    RowBox[{"filename_", ",", " ", "parameterSets_Association"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\n", "\t", "\n", "\t", 
      RowBox[{
      "FormatParams", ",", "\n", "\t", "\n", "\t", "varyingParams", ",", "\n",
        "    ", "fixedParams", ",", "\n", "    ", "paramNames", ",", "\n", 
       "    ", "paramRanges", ",", "\n", "    ", "allCombinations", ",", "\n",
        "    ", "solvedEquations", ",", "\n", "    ", "columnNames", ",", 
       "\n", "    ", "resultsDataset"}], "}"}], ",", "\n", "    ", "\n", 
     "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"FormatParams", "[", "params_Association", "]"}], " ", ":=", 
       " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"KeyDrop", "[", 
          RowBox[{"params", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Mu]interact\>\"", ",", 
             " ", "\"\<\[Sigma]interact\>\""}], "}"}]}], "]"}], ",", " ", 
         "\n", "\t\t\t\t\t\t\t\t\t\t    ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<\[Mu]c\>\"", " ", "->", " ", 
            RowBox[{"params", "[", "\"\<\[Mu]interact\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<\[Sigma]c\>\"", " ", "->", " ", 
            RowBox[{"params", "[", "\"\<\[Sigma]interact\>\"", "]"}]}], ",", 
           " ", 
           RowBox[{"\"\<\[Mu]g\>\"", " ", "->", " ", 
            RowBox[{"params", "[", "\"\<\[Mu]interact\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<\[Sigma]g\>\"", " ", "->", " ", 
            RowBox[{"params", "[", "\"\<\[Sigma]interact\>\"", "]"}]}]}], 
          "|>"}]}], "]"}]}], ";", "\n", " ", "\n", "\t", 
      RowBox[{"varyingParams", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"parameterSets", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "0"}], " ", 
          "&"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"fixedParams", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"parameterSets", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], " ", "===", " ", "0"}], " ", 
          "&"}]}], "]"}]}], ";", "\n", "    ", "\n", "    ", 
      RowBox[{"paramNames", " ", "=", " ", 
       RowBox[{"Keys", "[", "varyingParams", "]"}]}], ";", "\n", "    ", 
      RowBox[{"paramRanges", " ", "=", " ", 
       RowBox[{"Values", "[", "varyingParams", "]"}]}], ";", "\n", "    ", 
      RowBox[{"allCombinations", " ", "=", " ", 
       RowBox[{"Tuples", "[", "paramRanges", "]"}]}], ";", "\n", "    ", "\n",
       "    ", 
      RowBox[{"LaunchKernels", "[", "]"}], ";", "\n", "\t", 
      RowBox[{"DistributeDefinitions", "[", 
       RowBox[{"SCEsLinearExpansion", ",", " ", "FormatParams"}], "]"}], ";", 
      "\n", "\t", 
      RowBox[{"ParallelEvaluate", "[", 
       RowBox[{"Off", "[", 
        RowBox[{"Set", "::", "shape"}], "]"}], "]"}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"solvedEquations", " ", "=", " ", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "paramSet", "}"}], ",", "\n", 
           "\t\t\t\t\t\t\t\t\t\t  ", 
           RowBox[{
            RowBox[{"paramSet", " ", "=", " ", 
             RowBox[{"FormatParams", "[", 
              RowBox[{"Join", "[", 
               RowBox[{"fixedParams", ",", " ", 
                RowBox[{"AssociationThread", "[", 
                 RowBox[{"paramNames", ",", " ", "parmcombo"}], "]"}]}], 
               "]"}], "]"}]}], ";", "\n", "\t\t\t\t\t\t\t\t\t\t  ", 
            RowBox[{"SCEsLinearExpansion", "[", "paramSet", "]"}]}]}], "]"}], 
         ",", "\n", "\t\t\t\t\t\t\t\t\t", 
         RowBox[{"{", 
          RowBox[{"parmcombo", ",", " ", "allCombinations"}], "}"}]}], 
        "]"}]}], ";", "\n", "\t\t\t\t\t\t\t\t\t", "\n", "\t", 
      RowBox[{"columnNames", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<gamma\>\"", ",", " ", "\"\<rho\>\"", ",", 
